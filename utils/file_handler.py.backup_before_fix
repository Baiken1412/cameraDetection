"""
文件处理工具模块
"""
import json
import logging
from typing import List, Dict, Union
from pathlib import Path

logger = logging.getLogger(__name__)


def save_json(data: Union[Dict, List], file_path: Union[str, Path], indent: int = 2):
    """
    保存JSON文件

    Args:
        data: 要保存的数据
        file_path: 文件路径
        indent: 缩进空格数
    """
    file_path = Path(file_path)
    file_path.parent.mkdir(parents=True, exist_ok=True)

    with open(file_path, 'w', encoding='utf-8') as f:
        json.dump(data, f, ensure_ascii=False, indent=indent)

    logger.info(f"JSON已保存: {file_path}")


def load_json(file_path: Union[str, Path]) -> Union[Dict, List]:
    """
    加载JSON文件

    Args:
        file_path: 文件路径

    Returns:
        Dict or List: JSON数据
    """
    file_path = Path(file_path)

    if not file_path.exists():
        raise FileNotFoundError(f"文件不存在: {file_path}")

    with open(file_path, 'r', encoding='utf-8') as f:
        data = json.load(f)

    logger.info(f"JSON已加载: {file_path}")
    return data


def scan_images(
    directory: Union[str, Path],
    extensions: List[str] = None
) -> List[Path]:
    """
    扫描目录下的所有图片文件

    Args:
        directory: 目录路径
        extensions: 支持的文件扩展名列表

    Returns:
        List[Path]: 图片文件路径列表
    """
    if extensions is None:
        extensions = ['.jpg', '.jpeg', '.png', '.bmp', '.webp']

    directory = Path(directory)

    if not directory.exists():
        raise FileNotFoundError(f"目录不存在: {directory}")

    image_paths = []
    for ext in extensions:
        image_paths.extend(directory.glob(f"*{ext}"))
        image_paths.extend(directory.glob(f"*{ext.upper()}"))

    # 排序
    image_paths = sorted(image_paths)

    logger.info(f"扫描到 {len(image_paths)} 张图片 in {directory}")

    return image_paths


def ensure_dir(directory: Union[str, Path]):
    """
    确保目录存在，不存在则创建

    Args:
        directory: 目录路径
    """
    directory = Path(directory)
    directory.mkdir(parents=True, exist_ok=True)


def get_relative_path(path: Union[str, Path], base_path: Union[str, Path]) -> str:
    """
    获取相对路径

    Args:
        path: 文件路径
        base_path: 基准路径

    Returns:
        str: 相对路径
    """
    path = Path(path)
    base_path = Path(base_path)

    try:
        rel_path = path.relative_to(base_path)
        return str(rel_path)
    except ValueError:
        # 如果不在同一路径下，返回绝对路径
        return str(path)


def count_files(directory: Union[str, Path], pattern: str = "*") -> int:
    """
    统计目录下的文件数量

    Args:
        directory: 目录路径
        pattern: 文件模式

    Returns:
        int: 文件数量
    """
    directory = Path(directory)

    if not directory.exists():
        return 0

    files = list(directory.glob(pattern))
    return len(files)
